# Enforce LF line endings for text files
* text=auto

# YAML files should always use LF
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Python files should use LF
*.py text eol=lf

# TypeScript/JavaScript files should use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Markdown files should use LF
*.md text eol=lf

# Docker files should use LF
Dockerfile text eol=lf
*.dockerfile text eol=lf
