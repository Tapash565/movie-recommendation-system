DATABASE_URL=postgresql://user:password@host:port/dbname
DB_HOST=localhost
DB_NAME=postgres
DB_PASSWORD=password
DB_PORT=5432
DB_USER=postgres
# SECURITY WARNING: NEVER commit your Firebase service account JSON to version control.
# 1. Download your JSON from: Firebase Console → Project Settings → Service Accounts
# 2. Ensure the filename (e.g. firebase-adminsdk.json) is added to your .gitignore
# 3. For production, use environment variables or a secret management solution (AWS Secret Manager, HashiCorp Vault, etc.)
# The path below is a LOCAL PLACEHOLDER only.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-adminsdk.json
ENVIRONMENT=development
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token
