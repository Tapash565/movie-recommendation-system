# =============================================================================
# Environment Configuration Template
# =============================================================================
# Copy this file to .env.development, .env.staging, .env.production, or .env.test
# and update the values for your environment.
#
# Usage:
#   - Development: cp .env.example .env.development
#   - Staging: cp .env.example .env.staging
#   - Production: cp .env.example .env.production
#   - Testing: cp .env.example .env.test
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Environment mode: development | staging | production | test
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Full database URL (takes precedence if set)
# Leave empty to use DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD instead
DATABASE_URL=

# Individual database connection parameters (used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=password

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
# Path to Firebase service account JSON file (local development only)
# SECURITY: NEVER commit this file to version control
# Download from: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=

# Google Cloud Project ID (required for production)
GOOGLE_CLOUD_PROJECT=

# Firebase Emulator settings (local development only)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_DATABASE_EMULATOR_HOST=localhost:9000

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Server port
PORT=8000

# CORS origins (comma-separated)
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# HuggingFace
# -----------------------------------------------------------------------------
# HuggingFace API token for model inference
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG for development, WARNING for production
LOG_LEVEL=INFO
